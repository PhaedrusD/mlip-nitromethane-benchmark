NAME = C_sp.inp
|  1> # C atom, ground state 3P, multiplicity 3
|  2> # single point only: nothing to optimise, no vibrations, ZPE = 0
|  3> ! CCSD(T) aug-cc-pVQZ TightSCF
|  4> %maxcore 8000
|  5> %method
|  6>   FrozenCore FC_NONE
|  7> end
|  8> %scf
|  9>   STABPerform true      # open-shell p atoms can converge to a broken solution
| 10>   MaxIter 300
| 11> end
| 12> * xyz 0 3
| 13> C   0.0  0.0  0.0
| 14> *
| 15> 
| 16>                          ****END OF INPUT****
