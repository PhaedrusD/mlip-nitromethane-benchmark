# H atom, ground state 2S, multiplicity 2
# single point only: nothing to optimise, no vibrations, ZPE = 0
! UHF aug-cc-pVQZ TightSCF
%maxcore 8000
%method
  FrozenCore FC_NONE
end
%scf
  STABPerform true      # open-shell p atoms can converge to a broken solution
  MaxIter 300
end
* xyz 0 2
H   0.0  0.0  0.0
*
