# N atom, ground state 4S, multiplicity 4
# single point only: nothing to optimise, no vibrations, ZPE = 0
! CCSD(T) aug-cc-pVQZ TightSCF
%maxcore 8000
%method
  FrozenCore FC_NONE
end
%scf
  STABPerform true      # open-shell p atoms can converge to a broken solution
  MaxIter 300
end
* xyz 0 4
N   0.0  0.0  0.0
*
