NAME = CO_sp.inp
|  1> # CO: STEP 2 of 2 -- energy at
|  2> # CCSD(T)=FULL/aug-cc-pVQZ//wB97X-D3/def2-TZVP
|  3> # Reads the optimised geometry from CO_opt.xyz (run CO_opt.inp first).
|  4> # NOTE: `* xyzfile` takes NO closing asterisk.
|  5> ! CCSD(T) aug-cc-pVQZ TightSCF
|  6> %maxcore 8000
|  7> %method
|  8>   FrozenCore FC_NONE
|  9> end
| 10> * xyzfile 0 1 CO_opt.xyz
| 11> 
| 12>                          ****END OF INPUT****
