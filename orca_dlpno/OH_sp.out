================================================================================
                                       INPUT FILE
================================================================================
NAME = OH_sp.inp
|  1> # OH: STEP 2 of 2 -- energy at
|  2> # DLPNO-CCSD(T)=FULL/aug-cc-pVQZ//wB97X-D3/def2-TZVP
|  3> # Reads the optimised geometry from OH_opt.xyz (run OH_opt.inp first).
|  4> # NOTE: `* xyzfile` takes NO closing asterisk.
|  5> ! DLPNO-CCSD(T) aug-cc-pVQZ aug-cc-pVQZ/C TightPNO TightSCF
|  6> %maxcore 8000
|  7> %method
|  8>   FrozenCore FC_NONE
|  9> end
| 10> * xyzfile 0 2 OH_opt.xyz
| 11> 
| 12>                          ****END OF INPUT****
