================================================================================
                                       INPUT FILE
================================================================================
NAME = H_sp.inp
|  1> # H atom, ground state 2S, multiplicity 2
|  2> # single point only: nothing to optimise, no vibrations, ZPE = 0
|  3> ! UHF aug-cc-pVQZ TightSCF
|  4> %maxcore 8000
|  5> %method
|  6>   FrozenCore FC_NONE
|  7> end
|  8> %scf
|  9>   STABPerform true      # open-shell p atoms can converge to a broken solution
| 10>   MaxIter 300
| 11> end
| 12> * xyz 0 2
| 13> H   0.0  0.0  0.0
| 14> *
| 15> 
| 16>                          ****END OF INPUT****
