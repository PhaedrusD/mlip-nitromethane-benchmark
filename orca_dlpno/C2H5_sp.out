================================================================================
                                       INPUT FILE
================================================================================
NAME = C2H5_sp.inp
|  1> # C2H5: STEP 2 of 2 -- energy at
|  2> # DLPNO-CCSD(T)=FULL/aug-cc-pVQZ//wB97X-D3/def2-TZVP
|  3> # Reads the optimised geometry from C2H5_opt.xyz (run C2H5_opt.inp first).
|  4> # NOTE: `* xyzfile` takes NO closing asterisk.
|  5> ! DLPNO-CCSD(T) aug-cc-pVQZ aug-cc-pVQZ/C TightPNO TightSCF
|  6> %maxcore 8000
|  7> %method
|  8>   FrozenCore FC_NONE
|  9> end
| 10> * xyzfile 0 2 C2H5_opt.xyz
| 11> 
| 12>                          ****END OF INPUT****
